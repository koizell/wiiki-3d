# Navegadores descargados por herramientas de auditoría (no subir nunca)
chrome/
/chrome/
# Próxima vez: npx @puppeteer/browsers install chrome@stable --path ~/.cache/puppeteer

# Perfiles de Chrome que deja Lighthouse al auditar (artefacto local).
# Próxima vez: pasa --user-data-dir=/tmp/... al invocar lighthouse para que
# Chrome no cree el perfil en el CWD.
*lighthouse.*/

# Skills, agentes y comandos de ux-toolkit. Se ignoran por subdirectorio y no el
# directorio entero, por si algún día hay config de OpenCode del proyecto ahí que
# sí deba versionarse. Se reinstalan con `npx ux-toolkit install --project`
# (documentado en el README).
.opencode/skills/
.opencode/commands/

# Los agentes del pipeline LLM Wiki (recolector, cocinero, redactor, revisor)
# son config del proyecto y sí se versionan. Los de ux-toolkit no: se reinstalan
# con `npx ux-toolkit install --project` (documentado en el README).
#
# El patrón lleva `/*` y no el directorio entero por una razón de git: no baja a
# un directorio excluido, así que con el directorio excluido las negaciones de
# abajo no tendrían efecto y estos cuatro ficheros seguirían ignorados.
.opencode/agents/*
!.opencode/agents/recolector.md
!.opencode/agents/cocinero.md
!.opencode/agents/redactor.md
!.opencode/agents/revisor.md

# Plugins de OpenCode. Graphify intenta instalar aquí un plugin que usa la API de
# plugins de la v1, y OpenCode 2 no ejecuta los plugins de la v1: carga el
# fichero, falla y lo registra como aviso en cada arranque. Como la integración
# funciona por `AGENTS.md` y por el skill, que sí se generan, el plugin no aporta
# nada y se regenera con cada reinstalación de Graphify.
# Documentado en el README.
.opencode/plugins/

# Salida de los scripts de verificación de layout (capturas y JSON en bruto).
# El código de los scripts sí se versiona, en scripts/verify/.
scripts/verify/out/

# Grafo de conocimiento de Graphify. Son artefactos derivados, como dist/: se
# regeneran con `graphify . --project --code-only` y con `graphify update .`
# cuando cambia el código. graph.json llega a 300 KB y GRAPH_REPORT.md cambia de
# forma distinta en cada reagrupación, así que versionarlos produciría conflictos
# en cada commit sin aportar nada. La configuración que sí importa —AGENTS.md— sí
# está versionada.
graphify-out/

# Notas de trabajo locales: planes de desarrollo, borradores y estado de esta
# máquina. No se suben a propósito.
#
# No van en `docs/` porque `docs/` sí se versiona y contiene documentación del
# proyecto —historias de usuario, estado, diseño de Taller— que otra persona
# necesita para trabajar en esto. Un plan de la fase siguiente, con las tareas a
# medio hacer y los commits sin subir, es otra cosa: vale para la sesión que lo
# escribió y estorba en cuanto deja de ser cierto.
#
# Lo que sí sea decisión de producto va a `docs/` y se versiona, como ya pasó con
# `docs/taller.md`.
.local/
