# URL del Worker de Cloudflare que actúa como proxy de Jev.
# En producción: https://wiiki-3d-jev-proxy.wiiki3d-site.workers.dev
# En desarrollo: http://127.0.0.1:8787 (wrangler dev)
#
# Aquí solo va la URL, nunca la API key: el bundle es público y cualquier valor
# que Vite incruste en él es legible desde el navegador.
VITE_JEV_PROXY_URL=https://wiiki-3d-jev-proxy.wiiki3d-site.workers.dev

# Conmuta la ruta de `classifyWithJev` entre la real y la simulada.
#
# `true`  -> usa la heurística local de `mockClassify`, sin red. Es lo que hay que
#            usar mientras el backend de Jev esté caído, para poder seguir
#            desarrollando el panel de análisis.
# `false` -> llama de verdad a `${VITE_JEV_PROXY_URL}/classify`.
#
# OJO: se compara contra la cadena exacta "true". Cualquier otro valor (incluido
# "false" y unset) deja activa la ruta real, porque en Vite las variables llegan
# como texto y "false" sería truthy.
VITE_JEV_USE_MOCK=false